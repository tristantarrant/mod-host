#!/bin/sh
set -e

. /usr/share/debconf/confmodule

case "$1" in
    configure)
        # Clean up service file from old location (moved to /usr/lib/systemd/system/)
        rm -f /lib/systemd/system/jackd-modhost.service

        # Create dedicated system user for JACK/mod-host
        if ! getent passwd modhost >/dev/null 2>&1; then
            adduser --system --group --no-create-home \
                --home /nonexistent --shell /usr/sbin/nologin \
                modhost
        fi
        # Add to required groups: audio (ALSA/JACK), video/render/input/gpio (FlutterPi HMI)
        usermod -a -G audio,video,render,input,gpio modhost 2>/dev/null || true

        # Try the auto-detected device first, fall back to manual
        db_get mod-host/audio-device
        SELECTION="$RET"

        if [ -n "$SELECTION" ]; then
            # Parse "vendor:product - Manufacturer Product (hw:Name)"
            USB_VENDOR=$(echo "$SELECTION" | cut -d: -f1)
            USB_PRODUCT=$(echo "$SELECTION" | cut -d: -f2 | cut -d' ' -f1)
            ALSA_DEVICE=$(echo "$SELECTION" | sed 's/.*hw:\([^)]*\)).*/\1/')
        else
            # Fall back to manual entry: "vendor:product:alsa_name"
            db_get mod-host/audio-device-manual
            MANUAL="$RET"
            USB_VENDOR=$(echo "$MANUAL" | cut -d: -f1)
            USB_PRODUCT=$(echo "$MANUAL" | cut -d: -f2)
            ALSA_DEVICE=$(echo "$MANUAL" | cut -d: -f3)
        fi

        if [ -z "$USB_VENDOR" ] || [ -z "$USB_PRODUCT" ] || [ -z "$ALSA_DEVICE" ]; then
            echo "Warning: incomplete audio device configuration." >&2
            echo "Run 'dpkg-reconfigure mod-host' to configure." >&2
        else
            # Generate udev rule
            mkdir -p /etc/udev/rules.d
            cat > /etc/udev/rules.d/80-mod-host.rules <<EOF
# Auto-generated by mod-host package
# USB audio device: Vendor=$USB_VENDOR Product=$USB_PRODUCT
SUBSYSTEM=="sound", ACTION=="add", ATTRS{idVendor}=="$USB_VENDOR", ATTRS{idProduct}=="$USB_PRODUCT", TAG+="systemd", ENV{SYSTEMD_WANTS}="jackd-modhost.service"
SUBSYSTEM=="sound", ACTION=="remove", ATTRS{idVendor}=="$USB_VENDOR", ATTRS{idProduct}=="$USB_PRODUCT", TAG+="systemd"
EOF

            # Update ALSA device in jackd.conf
            if [ -f /etc/jackd/jackd.conf ]; then
                sed -i "s/^ALSA_DEVICE=.*/ALSA_DEVICE=\"$ALSA_DEVICE\"/" /etc/jackd/jackd.conf
            fi

            # Reload udev rules
            udevadm control --reload-rules 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
